# ==========================================
# Frontend Configuration (Vercel)
# ==========================================

# Render backend URL (e.g., https://coftea-pos-api.onrender.com)
# Leave blank or omit in local dev if you want Vite to proxy to http://localhost:5000
VITE_API_URL=https://your-render-app.onrender.com

# Supabase public connection
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key_here
