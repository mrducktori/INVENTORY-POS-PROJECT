# ==========================================
# Backend Configuration (Render)
# ==========================================

NODE_ENV=production
PORT=5000

# Supabase Admin / Service Role (bypasses RLS for secure server operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Signing Secret (use a long random 32+ character string)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL(s) for CORS whitelisting (comma-separated if multiple)
# Only these origins are allowed (no *.vercel.app wildcard); add preview URLs here or via ALLOWED_ORIGINS
CLIENT_URL=https://your-frontend.vercel.app

# Optional: Google Gemini API Key for inventory forecasting (plus optional backup failover key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key_here
